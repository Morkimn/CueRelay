<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_dark"
    android:padding="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:gravity="center_vertical" android:layout_weight="1" android:layout_marginBottom="6dp">
        <ImageView android:id="@+id/artwork" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/art_dark"
            android:scaleType="centerCrop" android:clipToOutline="true" android:src="@drawable/ic_note"
            android:contentDescription="Обложка"/>
        <include layout="@layout/widget_toggle" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:gravity="center_vertical" android:layout_weight="1">
        <ImageView android:id="@+id/source" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/button_dark" android:padding="8dp" android:scaleType="centerInside"
            android:src="@drawable/ic_source" android:contentDescription="Выбрать источник"/>
        <ImageView android:id="@+id/next" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
            android:background="@drawable/button_dark" android:padding="8dp" android:scaleType="centerInside"
            android:src="@drawable/ic_next" android:contentDescription="Следующий трек"/>
    </LinearLayout>
</LinearLayout>
